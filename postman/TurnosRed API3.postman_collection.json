      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Respuesta JSON coherente', () => pm.expect(pm.response.json().exito).to.eql(true));"
            ]
          }
        }
      ]
    },

{
  "info": {
    "name": "TurnosRed API 3",
    "description": "Ejecutar en orden sobre un servidor recién iniciado. Datos ficticios. Reiniciar antes de repetir la colección porque la matrícula se conserva tras la baja lógica. Puerto predeterminado 3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "especialidadNueva",
      "value": ""
    },
    {
      "key": "profesionalNuevo",
      "value": ""
    }
  ],
